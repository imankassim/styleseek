DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional — falls back to database/.env, then omitted (OpenSearch treated as unavailable).
OPENSEARCH_URL=https://user:password@host

# Optional — comma-separated allowlist for the deployed frontend origin(s). Defaults to the
# local Next.js dev server (http://localhost:3000) if unset.
CORS_ORIGINS=https://your-deployed-frontend.example.com
